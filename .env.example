# Configuración General de la Aplicación
APP_NAME="Sistema de Gestión de Inventarios y POS"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Base de Datos PostgreSQL
# Formato: postgresql+psycopg2://<usuario>:<password>@<host>:<puerto>/<nombre_bd>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pos_db #<---- Obligarorio

# Configuraciones opcionales (no necesarias)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# Seguridad y Criptografía
SECRET_KEY=pos_clave_secreta_super_segura_para_desarrollo_local_12345
HASH_ALGORITHM=argon2
SESSION_TIMEOUT_MINUTES=480

# Logging
LOG_LEVEL=INFO
